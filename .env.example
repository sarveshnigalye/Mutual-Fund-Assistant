# === LLM Configuration (Groq) ===
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=300

# === Optional Alternative Providers ===
GOOGLE_API_KEY=
OPENAI_API_KEY=

# === Embedding Configuration ===
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Vector Store Settings (Local, Pinecone, or ChromaDB) ===
VECTOR_DB_PROVIDER=local
VECTORSTORE_PATH=./data/vectorstore
VECTORSTORE_COLLECTION=mf_faq_corpus
CHROMA_DB_PATH=./data/chroma

# Snapshot metadata (Phase 7 daily refresh); the backend reloads the index when it changes
DATA_METADATA_PATH=./data/metadata.json
INDEX_RELOAD_CHECK_SECONDS=60

# Hosted deployment (Railway, see Docs/deployment-plan.md) — leave empty for local use.
# SNAPSHOT_REPO: owner/repo whose data-snapshot branch the app downloads (startup + refresh + poll)
SNAPSHOT_REPO=
SNAPSHOT_BRANCH=data-snapshot
# SNAPSHOT_TOKEN: read-only GitHub token, private repos only
SNAPSHOT_TOKEN=
# SNAPSHOT_POLL_HOURS: e.g. 6 in production; 0 = only startup sync + /api/admin/refresh-data
SNAPSHOT_POLL_HOURS=0
# REFRESH_TOKEN: enables /api/admin/* (Bearer token); empty = those endpoints are disabled (404)
REFRESH_TOKEN=
# RATE_LIMIT_PER_MINUTE: /api/chat calls per client IP per minute; e.g. 20 in production; 0 = off
RATE_LIMIT_PER_MINUTE=0
MAX_REQUEST_BYTES=16384

# Pinecone Cloud (Optional - if VECTOR_DB_PROVIDER=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mf-faq-corpus
PINECONE_ENVIRONMENT=us-east-1

# === Retrieval Settings ===
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.65

# === Chat Database ===
CHAT_DB_PATH=./data/chat.db

# === Server Configuration ===
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# === Scraping Settings ===
BROWSER_TYPE=edge
SCRAPE_DELAY_SECONDS=2
CHROME_DRIVER_PATH=auto

